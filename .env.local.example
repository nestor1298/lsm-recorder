# ──────────────────────────────────────────────────────────────────────────
# SignaLab corpus pilot — environment variables
# Copy to `.env.local` and fill from the `cdk deploy` stack outputs.
# NEVER commit `.env.local` or real values. No AWS account ids in the repo.
# ──────────────────────────────────────────────────────────────────────────

# Region where the SignalabPilotStack is deployed.
AWS_REGION=us-east-1

# ── Cognito (client-side: Amplify Auth runs in the browser) ────────────────
# From stack outputs: UserPoolId / UserPoolClientId.
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Server-only resource names (never exposed to the client) ───────────────
# From stack outputs: CorpusTableName / RecordingsBucketName / ConsentBucketName.
SIGNALAB_CORPUS_TABLE=signalab-corpus
SIGNALAB_RECORDINGS_BUCKET=signalab-recordings-ACCOUNT-REGION
SIGNALAB_CONSENT_BUCKET=signalab-consent-ACCOUNT-REGION

# ── Runtime AWS credentials (server-only) ──────────────────────────────────
# Keys for an IAM user/role with the `signalab-app-runtime` managed policy
# attached (AppRuntimePolicyArn stack output). Set these in Vercel project env.
# IMPORTANT: use the SIGNALAB_-prefixed names. Vercel functions run on AWS
# Lambda, where AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are runtime-reserved
# and may be stripped or shadowed.
SIGNALAB_AWS_REGION=us-west-1
SIGNALAB_AWS_ACCESS_KEY_ID=
SIGNALAB_AWS_SECRET_ACCESS_KEY=
